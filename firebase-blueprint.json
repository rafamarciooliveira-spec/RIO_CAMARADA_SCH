{
  "entities": {
    "Member": {
      "title": "Member",
      "description": "Registration and membership information for an association member.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the member"
        },
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the member"
        },
        "fullName": {
          "type": "string",
          "maxLength": 150,
          "description": "Full legal name"
        },
        "cpf": {
          "type": "string",
          "maxLength": 20,
          "description": "Brazilian CPF identifier"
        },
        "birthDate": {
          "type": "string",
          "maxLength": 20,
          "description": "Date of birth in YYYY-MM-DD or DD/MM/YYYY"
        },
        "email": {
          "type": "string",
          "maxLength": 120,
          "description": "Contact and account email"
        },
        "phone": {
          "type": "string",
          "maxLength": 30,
          "description": "Contact phone or WhatsApp"
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 2000,
          "description": "URL or avatar of the member photo"
        },
        "membershipNumber": {
          "type": "string",
          "maxLength": 30,
          "description": "Official association registry number (Matrícula)"
        },
        "category": {
          "type": "string",
          "maxLength": 50,
          "description": "Member tier or category (e.g., Efetivo, Fundador, Benemérito)"
        },
        "status": {
          "type": "string",
          "enum": [
            "pendente",
            "aprovado",
            "rejeitado",
            "expirado"
          ],
          "description": "Approval status of membership"
        },
        "rejectionReason": {
          "type": "string",
          "maxLength": 500,
          "description": "Explanation if rejected or requires correction"
        },
        "lgpdConsent": {
          "type": "boolean",
          "description": "Whether user gave consent under Brazilian LGPD"
        },
        "lgpdConsentDate": {
          "type": "string",
          "maxLength": 40,
          "description": "ISO timestamp of LGPD consent"
        },
        "validUntil": {
          "type": "string",
          "maxLength": 30,
          "description": "Validade da carteirinha (AAAA-MM-DD), definida pela diretoria na aprovação; vazia enquanto pendente"
        },
        "renewalCount": {
          "type": "number",
          "description": "Number of times membership was renewed"
        },
        "lastGeneratedAt": {
          "type": "string",
          "maxLength": 40,
          "description": "ISO timestamp when the digital card was last generated for viewing"
        },
        "lastViewToken": {
          "type": "string",
          "maxLength": 64,
          "description": "24-hour verification token for anti-screenshot and fraud prevention"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 40,
          "description": "Timestamp of initial registration"
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 40,
          "description": "Timestamp of last update"
        }
      },
      "required": [
        "userId",
        "fullName",
        "cpf",
        "email",
        "status",
        "lgpdConsent"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Administrator account role entry.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "maxLength": 120,
          "description": "Admin email address"
        },
        "role": {
          "type": "string",
          "maxLength": 30,
          "description": "Role name e.g. superadmin, gestor"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 40,
          "description": "Timestamp created"
        }
      },
      "required": [
        "email",
        "role"
      ]
    },
    "CardTemplate": {
      "title": "CardTemplate",
      "description": "Visual layout and styling presets for digital membership cards.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Template ID"
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Name of the template style"
        },
        "associationName": {
          "type": "string",
          "maxLength": 150,
          "description": "Name of the association"
        },
        "associationSubtitle": {
          "type": "string",
          "maxLength": 150,
          "description": "Subtitle, CNPJ, or motto"
        },
        "logoUrl": {
          "type": "string",
          "maxLength": 2000,
          "description": "Logo image URL or SVG icon name"
        },
        "primaryColor": {
          "type": "string",
          "maxLength": 30,
          "description": "Primary card background or gradient start"
        },
        "secondaryColor": {
          "type": "string",
          "maxLength": 30,
          "description": "Secondary card gradient stop"
        },
        "accentColor": {
          "type": "string",
          "maxLength": 30,
          "description": "Accent and border color"
        },
        "textColor": {
          "type": "string",
          "maxLength": 30,
          "description": "Card text color"
        },
        "orientation": {
          "type": "string",
          "enum": [
            "horizontal",
            "vertical"
          ],
          "description": "Layout orientation"
        },
        "backgroundPattern": {
          "type": "string",
          "maxLength": 50,
          "description": "Pattern style (guilloche, waves, mesh, clean)"
        },
        "showQrCode": {
          "type": "boolean",
          "description": "Whether to display dynamic verification QR code"
        },
        "showPhoto": {
          "type": "boolean",
          "description": "Whether member photo is visible"
        },
        "showCpf": {
          "type": "boolean",
          "description": "Whether CPF is displayed on card"
        },
        "showBirthDate": {
          "type": "boolean",
          "description": "Whether birth date is displayed"
        },
        "showCategory": {
          "type": "boolean",
          "description": "Whether member category badge is displayed"
        },
        "showSecurityStamp": {
          "type": "boolean",
          "description": "Whether 24h holographic security stamp is rendered"
        },
        "customFields": {
          "type": "array",
          "description": "List of custom key-value field labels"
        },
        "signatureLabel": {
          "type": "string",
          "maxLength": 100,
          "description": "Signature title (e.g. Diretoria Executiva)"
        },
        "isDefault": {
          "type": "boolean",
          "description": "Whether this is the currently active template"
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 40,
          "description": "Last modified timestamp"
        }
      },
      "required": [
        "name",
        "associationName",
        "primaryColor"
      ]
    },
    "UserNotification": {
      "title": "UserNotification",
      "description": "In-app and push notification record for member status updates.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Notification ID"
        },
        "userId": {
          "type": "string",
          "description": "Target member UID"
        },
        "title": {
          "type": "string",
          "maxLength": 150,
          "description": "Notification title"
        },
        "message": {
          "type": "string",
          "maxLength": 500,
          "description": "Body message"
        },
        "type": {
          "type": "string",
          "maxLength": 50,
          "description": "Event type (status_change, approval, expiration)"
        },
        "read": {
          "type": "boolean",
          "description": "Read flag"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 40,
          "description": "Creation timestamp"
        }
      },
      "required": [
        "userId",
        "title",
        "message"
      ]
    },
    "SystemSetting": {
      "title": "SystemSetting",
      "description": "Global association settings such as customizable default rejection emails.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Setting ID e.g. rejection_email"
        },
        "subject": {
          "type": "string",
          "maxLength": 200,
          "description": "Email subject"
        },
        "body": {
          "type": "string",
          "maxLength": 5000,
          "description": "Customizable email template body with tags"
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 40,
          "description": "Last updated timestamp"
        },
        "updatedBy": {
          "type": "string",
          "maxLength": 120,
          "description": "Admin email who updated the template"
        }
      },
      "required": [
        "subject",
        "body"
      ]
    },
    "EmailDispatch": {
      "title": "EmailDispatch",
      "description": "Log of dispatched emails to applicant members upon rejection or status change.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Dispatch record ID"
        },
        "toEmail": {
          "type": "string",
          "maxLength": 120,
          "description": "Recipient email address"
        },
        "toName": {
          "type": "string",
          "maxLength": 150,
          "description": "Recipient member full name"
        },
        "memberId": {
          "type": "string",
          "description": "Associated member ID"
        },
        "userId": {
          "type": "string",
          "description": "Auth UID of the recipient"
        },
        "subject": {
          "type": "string",
          "maxLength": 200,
          "description": "Subject line delivered"
        },
        "body": {
          "type": "string",
          "maxLength": 5000,
          "description": "Delivered message body"
        },
        "status": {
          "type": "string",
          "enum": [
            "enviado",
            "pendente"
          ],
          "description": "Delivery status"
        },
        "sentAt": {
          "type": "string",
          "maxLength": 40,
          "description": "Timestamp of email dispatch"
        }
      },
      "required": [
        "toEmail",
        "subject",
        "body",
        "sentAt"
      ]
    },
    "PublicCard": {
      "title": "PublicCard",
      "description": "Projeção pública mínima da carteirinha, lida pela portaria ao escanear o QR. Nunca contém CPF, nascimento, e-mail ou telefone.",
      "type": "object",
      "properties": {
        "memberId": {
          "type": "string",
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "maxLength": 60,
          "description": "Nome reduzido, ex.: Maria S."
        },
        "category": {
          "type": "string",
          "maxLength": 60
        },
        "status": {
          "type": "string",
          "enum": [
            "pendente",
            "aprovado",
            "rejeitado",
            "expirado"
          ]
        },
        "validUntil": {
          "type": "string",
          "maxLength": 30
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "memberId",
        "displayName",
        "category",
        "status",
        "validUntil"
      ]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Registro somente de acréscimo de ações sensíveis (exportações, papéis). Sem dados pessoais em texto aberto.",
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "maxLength": 60
        },
        "actorUid": {
          "type": "string"
        },
        "rowCount": {
          "type": "number"
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "actorUid",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/members/{memberId}": {
      "schema": "Member",
      "description": "Stores membership profiles, approval statuses, and digital card view metadata."
    },
    "/admins/{adminId}": {
      "schema": "AdminUser",
      "description": "Stores registered administrator IDs and emails."
    },
    "/cardTemplates/{templateId}": {
      "schema": "CardTemplate",
      "description": "Stores customizable membership card visual templates created by admins."
    },
    "/notifications/{notificationId}": {
      "schema": "UserNotification",
      "description": "Stores status update notifications delivered to members."
    },
    "/systemSettings/{settingId}": {
      "schema": "SystemSetting",
      "description": "Stores association global configurations, including editable rejection email templates."
    },
    "/emailDispatches/{dispatchId}": {
      "schema": "EmailDispatch",
      "description": "Stores logged email communications delivered to rejected/pending members."
    },
    "/publicCards/{memberId}": {
      "schema": "PublicCard",
      "description": "Lida sem login pela validação do QR; gravada só pela diretoria."
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Criação só pela diretoria; nunca editada ou apagada."
    }
  }
}
