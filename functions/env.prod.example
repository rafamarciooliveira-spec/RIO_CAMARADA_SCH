# Copie para functions/.env.prod (o nome do alias em .firebaserc). Só parâmetros, NUNCA segredos.
# Os segredos (chaves do CPF, Resend, webhook) ficam no Secret Manager: ver docs/firebase-setup.md
FIRESTORE_DATABASE_ID=(default)
APP_URL=https://riocamarada.vercel.app
MAIL_FROM=Nome da Plataforma <nao-responda@SEU-DOMINIO>
ENFORCE_APP_CHECK=false
REQUIRE_MASTER_MFA=false
