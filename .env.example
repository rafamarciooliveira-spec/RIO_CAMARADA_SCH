# Sodalis: variáveis de ambiente
# Copie para .env.local (nunca versionado). Nenhum segredo deve ir para o repositório.
#
# O front usa só a configuração PÚBLICA do cliente Firebase, que fica em
# firebase-applet-config.json (apiKey de cliente não é segredo; a proteção vem das regras,
# do App Check e da restrição de domínio da chave no Google Cloud).

# URL pública do app (links de login por e-mail e do QR).
APP_URL="http://localhost:3000"

# Segredos do servidor (fase 1 em diante) ficam no Secret Manager do Firebase, NÃO aqui:
#   firebase functions:secrets:set RESEND_API_KEY
#   firebase functions:secrets:set CPF_ENCRYPTION_KEY
#   firebase functions:secrets:set CPF_HMAC_KEY
