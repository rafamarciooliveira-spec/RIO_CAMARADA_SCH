rules_version = '2';

// =====================================================================================
// Sodalis: regras do Firestore (modelo multi-tenant, fase 1)
//
// Princípios
// - Negar por padrão. Toda ESCRITA do cliente é negada em tenants/, slugs, users, plans e
//   platform: as escritas passam pela Cloud Function `api` (executeOp, código compartilhado).
// - Aqui só se decide LEITURA, por papel (permissões denormalizadas no vínculo
//   tenants/{t}/memberships/{uid}, recalculadas pelo servidor) e por dono do dado.
// - Revogação imediata: o vínculo é consultado a cada leitura (nada de claim com cache),
//   exceto o master da plataforma (claim `master`, com segundo fator).
// - E-mail verificado obrigatório para qualquer leitura que não seja pública.
// - Acesso de suporte expira sozinho (expiresAtMs conferido contra request.time).
// - Nenhum `list` amplo: consultas de quem não tem a permissão do módulo precisam filtrar
//   pelo próprio uid (ou pelo vínculo de dependente).
// Testes: tests/rules/tenant-isolation.test.ts (o CI falha se um acesso cruzado passar).
// =====================================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Primitivas ----------
    function authed() {
      return request.auth != null;
    }

    function emailOk() {
      return authed() && request.auth.token.email_verified == true;
    }

    // Master: claim concedida por script. Para exigir verificação em duas etapas no futuro
    // (Identity Platform), acrescente: && request.auth.token.get('firebase', {}).get('sign_in_second_factor', null) != null
    function isMaster() {
      return emailOk() && request.auth.token.get('master', false) == true;
    }

    function msPath(t) {
      return /databases/$(database)/documents/tenants/$(t)/memberships/$(request.auth.uid);
    }

    function ms(t) {
      return get(msPath(t)).data;
    }

    // Vínculo ativo, não expirado (suporte) e com e-mail verificado
    function isMember(t) {
      return emailOk() && exists(msPath(t)) && ms(t).get('active', false) == true &&
        (!('expiresAtMs' in ms(t)) || ms(t).expiresAtMs > request.time.toMillis());
    }

    function perm(t, mod, act) {
      return isMember(t) && ms(t).get('perms', {}).get(mod, []).hasAny([act]);
    }

    function isBoard(t) {
      return isMember(t) && ms(t).get('board', false) == true;
    }

    // memberId do vínculo (valor que nunca coincide quando não há cadastro de sócio)
    function myMemberId(t) {
      return ms(t).get('memberId', '__sem_cadastro__');
    }

    function isOwnUid(data) {
      return emailOk() && data.get('uid', '__sem_uid__') == request.auth.uid;
    }

    // Dono do cadastro do sócio: a própria conta ou o titular de um dependente
    function ownsMemberData(t, data) {
      return isOwnUid(data) || (isMember(t) && data.get('dependentOf', '__sem_titular__') == myMemberId(t));
    }

    function ownsMember(t, memberId) {
      return ownsMemberData(t, get(/databases/$(database)/documents/tenants/$(t)/members/$(memberId)).data);
    }

    // Visibilidade publico | socios | diretoria (agenda e biblioteca)
    function visible(t, data) {
      return data.get('visibility', 'diretoria') == 'publico' ||
        (data.get('visibility', 'diretoria') == 'socios' && isMember(t)) ||
        isBoard(t);
    }

    // ---------- Plataforma ----------
    match /slugs/{slug} {
      allow get: if true;
      allow list, write: if false;
    }

    match /plans/{planId} {
      allow get: if emailOk();
      allow list: if isMaster();
      allow write: if false;
    }

    match /platform/{docId} {
      allow get: if docId == 'config' && emailOk();
      allow list, write: if false;
    }

    match /platformAudit/{id} {
      allow read: if isMaster();
      allow write: if false;
    }

    match /supportAccess/{id} {
      allow read: if isMaster();
      allow write: if false;
    }

    match /users/{uid} {
      allow get: if emailOk() && uid == request.auth.uid;
      allow list, write: if false;
      match /{sub=**} {
        allow read, write: if false;
      }
    }

    match /rateLimits/{id} {
      allow read, write: if false;
    }

    // ---------- Sociedade ----------
    match /tenants/{t} {
      // Documento público da sociedade (identidade visual e rótulos; sem dado pessoal)
      allow get: if true;
      allow list, write: if false;

      // Nenhuma escrita do cliente em nada abaixo de tenants/{t}
      match /{path=**} {
        allow write: if false;
      }

      match /config/{docId} {
        // settings: necessário para o formulário de proposta; counters e outros: só o servidor
        allow get: if (docId == 'settings' && emailOk()) || (docId == 'news' && perm(t, 'noticias', 'ver'));
        allow list: if false;
      }

      match /stats/{docId} {
        allow get: if docId == 'dashboard' && isBoard(t);
        allow list: if false;
      }

      // Só o servidor
      match /idempotency/{id} { allow read: if false; }
      match /cpfIndex/{id} { allow read: if false; }
      match /cardTokens/{id} { allow read: if false; }
      match /outbox/{id} { allow read: if false; }
      match /icsTokens/{id} { allow read: if false; }
      match /paymentEvents/{id} { allow read: if false; }

      // ---------- Papéis e acesso ----------
      match /roles/{id} {
        allow read: if isMember(t);
      }

      match /memberships/{uid} {
        allow get: if (emailOk() && uid == request.auth.uid) || perm(t, 'papeis', 'ver');
        allow list: if perm(t, 'papeis', 'ver');
      }

      match /invites/{id} {
        allow read: if perm(t, 'papeis', 'ver');
      }

      // ---------- Sócios ----------
      match /members/{id} {
        allow get: if perm(t, 'socios', 'ver') || ownsMemberData(t, resource.data);
        // Sem a permissão, a consulta precisa filtrar uid == própria conta ou dependentOf == próprio cadastro
        allow list: if perm(t, 'socios', 'ver') || ownsMemberData(t, resource.data);

        match /private/{docId} {
          allow get: if docId == 'pii' && (perm(t, 'pii', 'ver') || ownsMember(t, id));
          allow list: if false;
        }

        match /history/{h} {
          allow read: if perm(t, 'socios', 'ver') || ownsMember(t, id);
        }

        // Pedidos de alteração: o CPF novo vai cifrado e só o servidor decifra
        match /changes/{c} {
          allow read: if perm(t, 'socios', 'aprovar') || ownsMember(t, id);
        }
      }

      // ---------- Carteirinha e portaria ----------
      match /cardTemplates/{id} {
        allow read: if isMember(t);
      }

      match /checkins/{id} {
        allow read: if perm(t, 'portaria', 'ver');
      }

      // ---------- Comunicação ----------
      match /notices/{id} {
        // Diretoria lê tudo. Os demais só avisos publicados e não restritos à diretoria; a consulta
        // precisa filtrar audience.boardOnly == false e status == 'publicado' (regra não é filtro).
        // Atenção: não usar get(campo, padrão) com "!=" em regra de list: na análise da consulta
        // o padrão é assumido e a lista passaria sem filtro (comprovado no teste).
        allow read: if isBoard(t) ||
          (isMember(t) && resource.data.audience.boardOnly == false && resource.data.status == 'publicado');

        match /reads/{uid} {
          allow get: if isMember(t) && uid == request.auth.uid;
          allow list: if perm(t, 'avisos', 'ver');
        }
      }

      match /notifications/{id} {
        allow read: if isOwnUid(resource.data);
      }

      match /calendar/{id} {
        allow read: if visible(t, resource.data);
      }

      // ---------- Financeiro ----------
      match /finAccounts/{id} { allow read: if perm(t, 'financeiro', 'ver'); }
      match /chartAccounts/{id} { allow read: if perm(t, 'financeiro', 'ver'); }
      match /costCenters/{id} { allow read: if perm(t, 'financeiro', 'ver'); }
      match /ledger/{id} { allow read: if perm(t, 'financeiro', 'ver'); }
      match /periods/{id} { allow read: if perm(t, 'financeiro', 'ver'); }
      match /statementLines/{id} { allow read: if perm(t, 'financeiro', 'ver'); }

      match /charges/{id} {
        allow read: if perm(t, 'financeiro', 'ver') || (emailOk() && resource.data.get('memberUid', '__sem_uid__') == request.auth.uid);
      }

      // ---------- Eventos, tarefas, atas ----------
      match /events/{id} {
        allow read: if resource.data.get('publicListing', false) == true || isMember(t);

        match /guests/{g} {
          allow read: if perm(t, 'eventos', 'ver') || isOwnUid(resource.data);
        }
      }

      match /tasks/{id} {
        allow read: if perm(t, 'tarefas', 'ver');
      }

      match /assemblies/{id} {
        allow read: if isMember(t);

        match /attendance/{a} {
          allow read: if perm(t, 'atas', 'ver');
        }
      }

      match /minutes/{id} {
        allow read: if perm(t, 'atas', 'ver') || (isMember(t) && resource.data.get('published', false) == true);

        match /versions/{v} {
          allow read: if perm(t, 'atas', 'ver');
        }
      }

      // ---------- Votações (voto secreto) ----------
      match /elections/{id} {
        allow read: if isMember(t);

        match /voters/{memberId} {
          allow get: if (isMember(t) && memberId == myMemberId(t)) || perm(t, 'votacoes', 'ver');
          allow list: if perm(t, 'votacoes', 'ver');
        }

        match /ballots/{b} {
          allow read: if false;
        }
      }

      // ---------- Módulos culturais ----------
      match /workshops/{id} { allow read: if isMember(t); }
      match /spaces/{id} { allow read: if isMember(t); }
      // Gestão atual aparece na página pública da sociedade, se a página estiver ligada
      match /terms/{id} {
        allow read: if isMember(t) ||
          (resource.data.current == true &&
            get(/databases/$(database)/documents/tenants/$(t)).data.get('publicPage', {}).get('enabled', false) == true);
      }
      match /honors/{id} { allow read: if isMember(t); }
      match /benefits/{id} { allow read: if isMember(t); }

      match /surveys/{id} {
        allow read: if isMember(t);

        match /voters/{uid} {
          allow get: if isMember(t) && uid == request.auth.uid;
          allow list: if false;
        }
      }

      match /bookings/{id} { allow read: if perm(t, 'reservas', 'ver'); }
      match /assets/{id} { allow read: if perm(t, 'patrimonio', 'ver'); }
      match /grants/{id} { allow read: if perm(t, 'editais', 'ver'); }
      match /sponsors/{id} { allow read: if perm(t, 'patrocinios', 'ver'); }

      match /library/{id} {
        allow read: if visible(t, resource.data);
      }

      // ---------- Notícias, competições e organograma ----------
      // Notícia pública aparece também na página pública; as de sócios, só para membros.
      // A consulta precisa filtrar hidden == false (e visibility == 'publico' para visitantes).
      match /news/{id} {
        allow read: if perm(t, 'noticias', 'editar') ||
          (resource.data.hidden == false && (isMember(t) ||
            (resource.data.visibility == 'publico' &&
              get(/databases/$(database)/documents/tenants/$(t)).data.get('publicPage', {}).get('enabled', false) == true)));
      }

      // Ranking: sócios sempre; visitantes só quando a competição marcar ranking público
      match /competitions/{cid} {
        allow read: if isMember(t) || resource.data.publicRanking == true;

        match /results/{rid} {
          allow read: if isMember(t) ||
            get(/databases/$(database)/documents/tenants/$(t)/competitions/$(cid)).data.publicRanking == true;
        }
        match /matches/{mid} {
          allow read: if isMember(t) ||
            get(/databases/$(database)/documents/tenants/$(t)/competitions/$(cid)).data.publicRanking == true;
        }
      }

      match /orgchart/{docId} {
        allow get: if isMember(t) || resource.data.showOnPublicPage == true;
        allow list: if false;
      }

      // Galeria de mandatos encerrados (ex-presidentes, ex-reis...)
      match /mandates/{id} {
        allow read: if isMember(t);
      }

      // ---------- Privacidade e auditoria ----------
      match /privacyRequests/{id} {
        allow read: if isOwnUid(resource.data) || perm(t, 'pii', 'ver');
      }

      match /audit/{id} {
        allow read: if perm(t, 'auditoria', 'ver');
      }
    }
  }
}
