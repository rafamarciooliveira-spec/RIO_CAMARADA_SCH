rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all (Master Gate)
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    // Administrador só é válido com e-mail verificado (Prevenção contra spoofing de identidade)
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isEmailVerified() && request.auth.token.email == 'rafa.marciooliveira@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isEmailVerified() && (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
          (request.auth.token.email != null && exists(/databases/$(database)/documents/admins/$(request.auth.token.email)))
        )
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Member Validation Helper
    function isValidMember(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 150 &&
             data.cpf is string && data.cpf.size() <= 20 &&
             data.email is string && data.email.size() <= 120 &&
             data.status in ['pendente', 'aprovado', 'rejeitado', 'expirado'] &&
             data.lgpdConsent == true;
    }

    // Card Template Validation Helper
    function isValidCardTemplate(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.associationName is string && data.associationName.size() > 0 && data.associationName.size() <= 300 &&
             data.primaryColor is string && data.primaryColor.size() <= 100;
    }

    // Helper for society events
    function isValidSocietyEvent(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.date is string && data.date.size() >= 8 && data.date.size() <= 30 &&
             data.type in ['sociedade', 'terceiro'];
    }

    // Helper for public sanitized card summary (sem dados sensíveis PII)
    function isValidPublicCard(data) {
      return data.fullName is string && data.fullName.size() <= 150 &&
             (!('cpf' in data)) &&
             (!('birthDate' in data)) &&
             (!('email' in data)) &&
             (!('phone' in data));
    }

    // 1. Members collection - PROTEGIDO (Somente o próprio sócio ou administradores podem ver)
    match /members/{memberId} {
      // Leitura permitida estritamente para o administrador ou para o próprio titular
      allow get: if isValidId(memberId) && (
        isAdmin() ||
        (isSignedIn() && existing().userId == request.auth.uid)
      );

      allow list: if isSignedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid
      );

      // Create: Sócio só pode criar seu próprio cadastro com status inicial 'pendente'
      allow create: if isSignedIn() &&
        isValidId(memberId) &&
        isValidMember(incoming()) &&
        (
          isAdmin() ||
          (
            incoming().userId == request.auth.uid &&
            incoming().status == 'pendente'
          )
        );

      // Update: Sócio só pode alterar o próprio nome, telefone, foto, data de nascimento e e-mail.
      // Ele NÃO pode mudar categoria, matrícula, situação ou validade.
      allow update: if isSignedIn() &&
        isValidId(memberId) &&
        isValidMember(incoming()) &&
        (
          isAdmin() ||
          (
            existing().userId == request.auth.uid &&
            incoming().userId == request.auth.uid &&
            incoming().cpf == existing().cpf &&
            incoming().category == existing().category &&
            incoming().membershipNumber == existing().membershipNumber &&
            incoming().validUntil == existing().validUntil &&
            incoming().status == existing().status &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'fullName',
              'birthDate',
              'photoUrl',
              'phone',
              'email',
              'allowBirthdayPublic',
              'allowEventPhotos',
              'allowCommunications',
              'consentVersion',
              'parentName',
              'parentCpf',
              'parentAuthorized',
              'isMinor',
              'updatedAt',
              'lastGeneratedAt',
              'lastViewToken'
            ])
          )
        );

      allow delete: if isAdmin();
    }

    // 2. Public Cards (Resumo seguro e público para validação QR Code: NUNCA expõe CPF, e-mail, telefone ou nascimento)
    match /publicCards/{memberId} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidPublicCard(incoming()) && (
        isAdmin() ||
        incoming().userId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // 3. Admin accounts (Membros da diretoria, tesoureiro, conselho fiscal)
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 4. Card templates para personalização visual
    match /cardTemplates/{templateId} {
      allow read: if true;
      allow write: if isAdmin() && isValidCardTemplate(incoming());
    }

    // 5. Notificações e Avisos (Somente administradores podem criar avisos)
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid
      );
      allow create: if isAdmin();
      allow update: if isSignedIn() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read']))
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // 6. E-mails registrados e comunicações da diretoria (Somente administradores podem disparar)
    match /emailDispatches/{dispatchId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        (request.auth.token.email != null && resource.data.toEmail == request.auth.token.email)
      );
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // 7. Eventos da Sociedade (Agenda) - Somente administradores podem criar, editar ou apagar
    match /events/{eventId} {
      allow read: if true;
      allow create: if isAdmin() && isValidSocietyEvent(incoming());
      allow update: if isAdmin() && isValidSocietyEvent(incoming());
      allow delete: if isAdmin();
    }

    // 8. Registro de auditoria administrativa (Exportação CSV, estornos, etc.)
    match /auditLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // 9. Configurações do Sistema
    match /systemSettings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 10. Links de Redes Sociais da Associação
    match /socialLinks/{linkId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 11. Espaço Cultural e Artigos Históricos
    match /cultureArticles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 12. Notícias de Tiro Esportivo
    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 13. Módulo Financeiro: Lançamentos & Livro Caixa (Imutável: nunca pode ser apagado, somente estornado)
    match /financialTransactions/{transId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false; // Lançamentos nunca podem ser apagados, só estornados
    }

    // 14. Módulo Financeiro: Contas e Categorias
    match /financialAccounts/{accId} {
      allow read, write: if isAdmin();
    }

    match /financialCategories/{catId} {
      allow read, write: if isAdmin();
    }

    // 15. Módulo Financeiro: Fechamentos Mensais
    match /financialMonthlyClosures/{closureId} {
      allow read, write: if isAdmin();
    }

    // 16. Módulo Financeiro: Mensalidades dos Sócios
    match /financialMemberFees/{feeId} {
      allow read, write: if isAdmin();
    }

    // 17. Módulo Financeiro: Prestação de Contas & Relatórios Publicados para os Sócios
    match /financialPublishedReports/{reportId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 18. Configurações Públicas do Site (Quem somos, endereço, telefone, rodapé, DPO)
    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 19. LGPD: Fila de Solicitações de Titulares
    match /dataRequests/{requestId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid
      );
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
